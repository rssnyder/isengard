[Unit]
Description=prometheus-pve-exporter
After=network-online.target

[Service]
Type=simple
SyslogIdentifier=pve-exporter
WorkingDirectory=/opt/pve-exporter
ExecStart=/opt/pve-exporter/bin/pve_exporter --config.file /opt/pve-exporter/pve.yml --web.listen-address :9221
Restart=on-failure

[Install]
WantedBy=default.target
